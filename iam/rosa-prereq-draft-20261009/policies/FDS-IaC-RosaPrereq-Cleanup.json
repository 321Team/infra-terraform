{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DetachOnlyRosaPolicies",
      "Effect": "Allow",
      "Action": "iam:DetachRolePolicy",
      "Resource": "arn:aws:iam::774055931866:role/fds-rosa-*",
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/service-role/ROSA*",
            "arn:aws:iam::774055931866:policy/fds-rosa-*",
            "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly"
          ]
        }
      }
    },
    {
      "Sid": "DeleteRosaRoles",
      "Effect": "Allow",
      "Action": [
        "iam:ListInstanceProfilesForRole",
        "iam:DeleteRole"
      ],
      "Resource": "arn:aws:iam::774055931866:role/fds-rosa-*"
    },
    {
      "Sid": "DeleteCliOwnedRolePolicy",
      "Effect": "Allow",
      "Action": "iam:DeletePolicy",
      "Resource": "arn:aws:iam::774055931866:policy/fds-rosa-*"
    },
    {
      "Sid": "DeleteRosaOidcProvider",
      "Effect": "Allow",
      "Action": "iam:DeleteOpenIDConnectProvider",
      "Resource": "arn:aws:iam::774055931866:oidc-provider/oidc.op1.openshiftapps.com/*"
    }
  ]
}
