{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunWithExactProbeAmi",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:ap-northeast-2::image/ami-0870825cefcaafcc8"
    },
    {
      "Sid": "ReadApprovedProbeRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::774055931866:role/FDS-P2-VPN-Probe-SSM",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::774055931866:role/FDS-IaC-Operator"
        }
      }
    },
    {
      "Sid": "ReadApprovedProbeProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::774055931866:instance-profile/FDS-P2-VPN-Probe-SSM",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::774055931866:role/FDS-IaC-Operator"
        }
      }
    },
    {
      "Sid": "PassApprovedProbeToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::774055931866:role/FDS-P2-VPN-Probe-SSM",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::774055931866:role/FDS-IaC-Operator"
        },
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadWriteProbeState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn-probe/terraform.tfstate",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::774055931866:role/FDS-IaC-Operator"
        },
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "ReadWriteDeleteProbeLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn-probe/terraform.tfstate.tflock",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::774055931866:role/FDS-IaC-Operator"
        },
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    },
    {
      "Sid": "DenyProbeStateDeletion",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn-probe/terraform.tfstate"
    },
    {
      "Sid": "DenyProbeLockVersionDeletion",
      "Effect": "Deny",
      "Action": "s3:DeleteObjectVersion",
      "Resource": "arn:aws:s3:::fds-tfstate-774055931866-ap-northeast-2/phase2/vpn-probe/terraform.tfstate.tflock"
    },
    {
      "Sid": "DenyProtectedProbeIdentityMutation",
      "Effect": "Deny",
      "NotAction": [
        "iam:Get*",
        "iam:List*",
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::774055931866:role/FDS-P2-VPN-Probe-SSM",
        "arn:aws:iam::774055931866:instance-profile/FDS-P2-VPN-Probe-SSM"
      ]
    }
  ]
}
