{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2AssumesProbeRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "ec2.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "774055931866"
        }
      }
    }
  ]
}
