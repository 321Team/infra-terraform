{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOwnKeyForApprovedRosaDateWithMFA",
      "Effect": "Allow",
      "Action": "iam:CreateAccessKey",
      "Resource": "arn:aws:iam::774055931866:user/321team-hayeoung",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::774055931866:user/321team-hayeoung"
        },
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        },
        "DateGreaterThanEquals": {
          "aws:CurrentTime": "2026-10-16T15:00:00Z"
        },
        "DateLessThan": {
          "aws:CurrentTime": "2026-10-18T15:00:00Z"
        }
      }
    },
    {
      "Sid": "ManageOwnKeyForApprovedCleanupWithMFA",
      "Effect": "Allow",
      "Action": [
        "iam:UpdateAccessKey",
        "iam:DeleteAccessKey"
      ],
      "Resource": "arn:aws:iam::774055931866:user/321team-hayeoung",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::774055931866:user/321team-hayeoung"
        },
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
